@model JobApply.Controllers.UsuariosController.UsuarioFormViewModel

@{
    ViewData["Title"] = "Novo usuário";
}

<div class="usuario-form-page">

    ```
    <!-- CABEÇALHO -->
    <div class="usuario-form-header">

        <div>
            <h1>Novo usuário</h1>

            <p>
                Cadastre um novo usuário no JobApply.
            </p>
        </div>

        <a asp-action="Index" class="voltar-button">
            ← Voltar
        </a>

    </div>


    <!-- FORMULÁRIO -->
    <div class="usuario-form-card">

        <div class="usuario-form-card-header">

            <div class="form-icon">
                👤
            </div>

            <div>
                <h2>Dados do usuário</h2>

                <p>
                    Preencha as informações para criar o acesso.
                </p>
            </div>

        </div>


        <div class="usuario-form-body">

            <form asp-action="Criar" method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDAÇÃO -->
                <div asp-validation-summary="ModelOnly" class="usuario-validation">
                </div>


                <!-- NOME -->
                <div class="usuario-field">

                    <label asp-for="Nome" class="usuario-label">
                        Nome
                    </label>

                    <input asp-for="Nome" class="usuario-input" autocomplete="username"
                        placeholder="Digite o nome do usuário" />

                    <span asp-validation-for="Nome" class="usuario-error">
                    </span>

                </div>


                <!-- EMAIL -->
                <div class="usuario-field">

                    <label asp-for="Email" class="usuario-label">

                        E-mail

                        <span class="campo-opcional">
                            (opcional)
                        </span>

                    </label>

                    <input asp-for="Email" type="email" class="usuario-input" autocomplete="email"
                        placeholder="exemplo@email.com" />

                    <span asp-validation-for="Email" class="usuario-error">
                    </span>

                </div>


                <!-- SENHA -->
                <div class="usuario-field">

                    <label asp-for="Senha" class="usuario-label">
                        Senha
                    </label>

                    <input asp-for="Senha" type="password" class="usuario-input" autocomplete="new-password"
                        placeholder="Digite a senha" />

                    <span asp-validation-for="Senha" class="usuario-error">
                    </span>

                </div>


                <!-- ATIVO -->
                <div class="usuario-active-box">

                    <label class="usuario-check">

                        <input asp-for="Ativo" class="usuario-checkbox" />

                        <span class="check-custom"></span>

                        <span class="check-content">

                            <strong>
                                Usuário ativo
                            </strong>

                            <small>
                                Permitir que este usuário acesse o JobApply.
                            </small>

                        </span>

                    </label>

                </div>


                <!-- AÇÕES -->
                <div class="usuario-form-actions">

                    <button type="submit" class="salvar-usuario-button">
                        Salvar usuário
                    </button>

                    <a asp-action="Index" class="cancelar-usuario-button">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

<style>
    /* =====================================================
       PÁGINA
       ===================================================== */

    .usuario-form-page {
        width: 100%;
        max-width: 850px;

        margin: 0 auto;

        padding: 20px 24px 50px;

        box-sizing: border-box;
    }


    /* =====================================================
       CABEÇALHO
       ===================================================== */

    .usuario-form-header {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 28px;
    }

    .usuario-form-header h1 {
        margin: 0;

        color: #ffffff;

        font-size: 32px;
        font-weight: 700;
    }

    .usuario-form-header p {
        margin: 7px 0 0;

        color: #94a3b8;

        font-size: 15px;
    }


    /* =====================================================
       VOLTAR
       ===================================================== */

    .voltar-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        min-height: 42px;

        padding: 0 16px;

        border-radius: 10px;

        background: rgba(255, 255, 255, 0.08);

        border: 1px solid rgba(255, 255, 255, 0.12);

        color: #e2e8f0;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;

        transition: 0.2s ease;
    }

    .voltar-button:hover {
        color: #ffffff;

        background: rgba(255, 255, 255, 0.13);
    }


    /* =====================================================
       CARD
       ===================================================== */

    .usuario-form-card {
        overflow: hidden;

        background: rgba(255, 255, 255, 0.97);

        border-radius: 18px;

        box-shadow:
            0 20px 45px rgba(0, 0, 0, 0.18);
    }


    /* =====================================================
       CABEÇALHO DO CARD
       ===================================================== */

    .usuario-form-card-header {
        display: flex;

        align-items: center;

        gap: 14px;

        padding: 22px 26px;

        border-bottom: 1px solid #e2e8f0;
    }

    .form-icon {
        width: 46px;
        height: 46px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: #eff6ff;

        font-size: 21px;
    }

    .usuario-form-card-header h2 {
        margin: 0;

        color: #0f172a;

        font-size: 18px;
        font-weight: 700;
    }

    .usuario-form-card-header p {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 13px;
    }


    /* =====================================================
       CORPO
       ===================================================== */

    .usuario-form-body {
        padding: 28px 26px;
    }


    /* =====================================================
       VALIDAÇÃO
       ===================================================== */

    .usuario-validation {
        margin-bottom: 22px;

        padding: 12px 14px;

        border-radius: 10px;

        background: #fef2f2;

        border: 1px solid #fecaca;

        color: #b91c1c;

        font-size: 13px;
    }

    .usuario-validation:empty {
        display: none;
    }


    /* =====================================================
       CAMPOS
       ===================================================== */

    .usuario-field {
        margin-bottom: 21px;
    }

    .usuario-label {
        display: block;

        margin-bottom: 7px;

        color: #334155;

        font-size: 13px;
        font-weight: 600;
    }

    .campo-opcional {
        color: #94a3b8;

        font-weight: 400;
    }

    .usuario-input {
        width: 100%;
        height: 46px;

        box-sizing: border-box;

        padding: 0 14px;

        border: 1px solid #cbd5e1;

        border-radius: 10px;

        background: #ffffff;

        color: #0f172a;

        font-size: 14px;

        outline: none;

        transition: 0.2s ease;
    }

    .usuario-input::placeholder {
        color: #94a3b8;
    }

    .usuario-input:focus {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .usuario-error {
        display: block;

        margin-top: 5px;

        color: #dc2626;

        font-size: 12px;
    }


    /* =====================================================
       USUÁRIO ATIVO
       ===================================================== */

    .usuario-active-box {
        margin-top: 5px;
        margin-bottom: 26px;

        padding: 15px;

        border-radius: 12px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;
    }

    .usuario-check {
        display: flex;

        align-items: center;

        gap: 12px;

        cursor: pointer;
    }

    .usuario-checkbox {
        position: absolute;

        opacity: 0;

        pointer-events: none;
    }

    .check-custom {
        width: 20px;
        height: 20px;

        flex-shrink: 0;

        border-radius: 6px;

        border: 2px solid #cbd5e1;

        background: #ffffff;

        transition: 0.2s ease;
    }

    .usuario-checkbox:checked+.check-custom {
        background: #2563eb;

        border-color: #2563eb;

        box-shadow:
            inset 0 0 0 4px #ffffff;
    }

    .check-content {
        display: flex;

        flex-direction: column;

        gap: 2px;
    }

    .check-content strong {
        color: #334155;

        font-size: 13px;
    }

    .check-content small {
        color: #64748b;

        font-size: 12px;
    }


    /* =====================================================
       AÇÕES
       ===================================================== */

    .usuario-form-actions {
        display: flex;

        align-items: center;

        gap: 10px;

        padding-top: 4px;
    }

    .salvar-usuario-button,
    .cancelar-usuario-button {
        min-height: 44px;

        padding: 0 19px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border-radius: 10px;

        font-size: 13px;
        font-weight: 600;

        text-decoration: none;

        cursor: pointer;

        transition: 0.2s ease;
    }

    .salvar-usuario-button {
        border: none;

        color: #ffffff;

        background: linear-gradient(135deg,
                #2563eb,
                #4f46e5);

        box-shadow:
            0 8px 18px rgba(37, 99, 235, 0.22);
    }

    .salvar-usuario-button:hover {
        transform: translateY(-1px);

        box-shadow:
            0 11px 23px rgba(37, 99, 235, 0.30);
    }

    .cancelar-usuario-button {
        color: #475569;

        background: #f1f5f9;

        border: 1px solid #e2e8f0;
    }

    .cancelar-usuario-button:hover {
        color: #0f172a;

        background: #e2e8f0;
    }


    /* =====================================================
       RESPONSIVO
       ===================================================== */

    @@media (max-width: 650px) {

        .usuario-form-page {
            padding: 15px 14px 40px;
        }

        .usuario-form-header {
            flex-direction: column;

            align-items: stretch;
        }

        .usuario-form-header h1 {
            font-size: 28px;
        }

        .voltar-button {
            width: 100%;
        }

        .usuario-form-card-header {
            padding: 18px;
        }

        .usuario-form-body {
            padding: 22px 18px;
        }

        .usuario-form-actions {
            flex-direction: column;
        }

        .salvar-usuario-button,
        .cancelar-usuario-button {
            width: 100%;
        }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}