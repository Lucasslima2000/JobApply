@model JobApply.Models.Usuario

@{
    ViewData["Title"] = "Excluir usuário";
}

<div class="mb-4">

    <h1 class="h3 mb-1">
        Excluir usuário
    </h1>

    <p class="text-muted">
        Confirme a exclusão do usuário.
    </p>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="alert alert-warning">
            Esta ação não pode ser desfeita.
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Nome
            </dt>

            <dd class="col-sm-9">
                @Model.Nome
            </dd>

            <dt class="col-sm-3">
                E-mail
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Email)
                    ? "Não informado"
                    : Model.Email)
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @(Model.Ativo ? "Ativo" : "Inativo")
            </dd>

        </dl>

        <form asp-action="ConfirmarExclusao"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Confirmar exclusão
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>