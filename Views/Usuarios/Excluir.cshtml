@model JobApply.Models.Usuario

@{
    ViewData["Title"] = "Excluir usuário";
}

<div class="usuario-delete-page">

    ```
    <!-- CABEÇALHO -->
    <div class="usuario-delete-header">

        <div>
            <h1>Excluir usuário</h1>

            <p>
                Confirme a exclusão do usuário.
            </p>
        </div>

        <a asp-action="Index" class="voltar-button">
            ← Voltar
        </a>

    </div>


    <!-- CARD DE CONFIRMAÇÃO -->
    <div class="usuario-delete-card">

        <div class="delete-card-header">

            <div class="delete-icon">
                ⚠️
            </div>

            <div>
                <h2>Confirmar exclusão</h2>

                <p>
                    Verifique os dados antes de continuar.
                </p>
            </div>

        </div>


        <div class="delete-card-body">

            <!-- AVISO -->
            <div class="delete-warning">

                <div class="warning-icon">
                    !
                </div>

                <div>
                    <strong>Esta ação não pode ser desfeita.</strong>

                    <p>
                        O usuário será removido do sistema permanentemente.
                    </p>
                </div>

            </div>


            <!-- DADOS -->
            <div class="usuario-delete-info">

                <div class="info-item">

                    <span class="info-label">
                        Nome
                    </span>

                    <span class="info-value">
                        @Model.Nome
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        E-mail
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Email)
                                                ? "Não informado"
                                                : Model.Email)

                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Status
                    </span>

                    <span class="info-value">

                        @if (Model.Ativo)
                        {
                            <span class="status-badge status-ativo">
                                <span class="status-dot"></span>
                                Ativo
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-inativo">
                                <span class="status-dot"></span>
                                Inativo
                            </span>
                        }

                    </span>

                </div>

            </div>


            <!-- AÇÕES -->
            <form asp-action="ConfirmarExclusao" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="delete-actions">

                    <button type="submit" class="confirm-delete-button">
                        Confirmar exclusão
                    </button>

                    <a asp-action="Index" class="cancel-delete-button">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

<style>
    /* =====================================================
