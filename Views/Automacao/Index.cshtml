
@model List<JobApply.Models.VagaLinkedIn>

@{
    ViewData["Title"] = "Automação";
}

<style>

    /* =====================================================
       PÁGINA
       ===================================================== */

    .automacao-page {
        width: 100%;
        min-height: calc(100vh - 68px);

        padding: 45px 30px 60px;
    }

    .automacao-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }


    /* =====================================================
       CABEÇALHO
       ===================================================== */

    .automacao-header {
        margin-bottom: 30px;
    }

    .automacao-header h1 {
        margin: 0;

        color: white;

        font-size: 34px;
        font-weight: 700;

        letter-spacing: -1px;
    }

    .automacao-header p {
        margin: 9px 0 0;

        color:
            rgba(255, 255, 255, 0.62);

        font-size: 15px;
    }


    /* =====================================================
       PAINEL DE FILTROS
       ===================================================== */

    .filtros-card {
        padding: 28px;

        border:
            1px solid rgba(255, 255, 255, 0.10);

        border-radius: 20px;

        background:
            rgba(255, 255, 255, 0.07);

        box-shadow:
            0 20px 45px rgba(0, 0, 0, 0.16);

        backdrop-filter: blur(14px);
    }

    .filtros-title {
        display: flex;
        align-items: center;
        gap: 10px;

        margin-bottom: 23px;

        color: white;

        font-size: 17px;
        font-weight: 600;
    }

    .filtros-title-icon {
        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background:
            rgba(37, 99, 235, 0.20);

        font-size: 16px;
    }


    /* =====================================================
       CAMPOS
       ===================================================== */

    .filtro-label {
        display: block;

        margin-bottom: 8px;

        color:
            rgba(255, 255, 255, 0.78);

        font-size: 13px;
        font-weight: 600;
    }

    .filtro-input,
    .filtro-select {
        width: 100%;
        height: 48px;

        padding:
            0 14px;

        border:
            1px solid rgba(255, 255, 255, 0.13);

        border-radius: 11px;

        outline: none;

        background:
            rgba(15, 23, 42, 0.65);

        color: white;

        font-size: 14px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }

    .filtro-input::placeholder {
        color:
            rgba(255, 255, 255, 0.38);
    }

    .filtro-input:hover,
    .filtro-select:hover {
        border-color:
            rgba(255, 255, 255, 0.25);
    }

    .filtro-input:focus,
    .filtro-select:focus {
        background:
            rgba(15, 23, 42, 0.85);

        border-color:
            #2563eb;

        box-shadow:
            0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .filtro-select option {
        background: #0f172a;
        color: white;
    }


    /* =====================================================
       BOTÃO BUSCAR
       ===================================================== */

    .buscar-area {
        margin-top: 23px;
    }

    .btn-buscar {
        height: 48px;

        padding:
            0 22px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        border: none;
        border-radius: 11px;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #1d4ed8
            );

        color: white;

        font-size: 14px;
        font-weight: 600;

        cursor: pointer;

        box-shadow:
            0 8px 20px rgba(37, 99, 235, 0.22);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            filter 0.2s ease;
    }

    .btn-buscar:hover {
        color: white;

        filter: brightness(1.06);

        transform: translateY(-1px);

        box-shadow:
            0 12px 25px rgba(37, 99, 235, 0.30);
    }


    /* =====================================================
       MENSAGEM
       ===================================================== */

    .mensagem-candidatura {
        margin-bottom: 25px;

        padding: 14px 17px;

        border-radius: 12px;

        border:
            1px solid rgba(255, 255, 255, 0.10);
    }


    /* =====================================================
       CABEÇALHO DOS RESULTADOS
       ===================================================== */

    .resultados-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-top: 40px;
        margin-bottom: 22px;
    }

    .resultados-header h2 {
        margin: 0;

        color: white;

        font-size: 22px;
        font-weight: 650;
    }

    .resultado-contador {
        padding:
            7px 12px;

        border:
            1px solid rgba(37, 99, 235, 0.25);

        border-radius: 20px;

        background:
            rgba(37, 99, 235, 0.12);

        color:
            #93c5fd;

        font-size: 12px;
        font-weight: 600;
    }


    /* =====================================================
       CARDS DAS VAGAS
       ===================================================== */

    .vaga-card {
        height: 100%;

        display: flex;
        flex-direction: column;

        padding: 23px;

        border:
            1px solid rgba(255, 255, 255, 0.09);

        border-radius: 18px;

        background:
            rgba(255, 255, 255, 0.96);

        box-shadow:
            0 15px 35px rgba(0, 0, 0, 0.15);

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            border-color 0.22s ease;
    }

    .vaga-card:hover {
        transform: translateY(-4px);

        border-color:
            rgba(255, 255, 255, 0.20);

        box-shadow:
            0 22px 45px rgba(0, 0, 0, 0.23);
    }

    .vaga-card-top {
        flex: 1;
    }

    .vaga-icon {
        width: 45px;
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 17px;

        border-radius: 12px;

        background:
            #eff6ff;

        font-size: 20px;
    }

    .vaga-title {
        margin: 0 0 15px;

        color: #111827;

        font-size: 17px;
        font-weight: 700;

        line-height: 1.35;
    }

    .vaga-info {
        margin-bottom: 9px;

        color: #6b7280;

        font-size: 13px;

        line-height: 1.5;
    }

    .vaga-info strong {
        color: #374151;
        font-weight: 600;
    }


    /* =====================================================
       PUBLICAÇÃO
       ===================================================== */

    .vaga-publicacao {
        display: inline-flex;

        margin-top: 5px;
        margin-bottom: 10px;

        padding:
            5px 9px;

        border-radius: 7px;

        background:
            #f3f4f6;

        color:
            #6b7280;

        font-size: 11px;
    }


    /* =====================================================
       STATUS LINKEDIN
       ===================================================== */

    .vaga-status {
        display: inline-flex;
        align-items: center;

        margin-top: 2px;
        margin-bottom: 18px;

        padding:
            5px 9px;

        border-radius: 7px;

        background:
            #eff6ff;

        color:
            #2563eb;

        font-size: 11px;
        font-weight: 600;
    }


    /* =====================================================
       BOTÕES DA VAGA
       ===================================================== */

    .vaga-actions {
        display: flex;

        gap: 8px;

        margin-top: 20px;
    }

    .vaga-button {
        flex: 1;

        min-height: 40px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding:
            0 10px;

        border-radius: 9px;

        font-size: 12px;
        font-weight: 600;

        text-decoration: none;

        transition:
            transform 0.2s ease,
            filter 0.2s ease;
    }

    .vaga-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
    }

    .btn-ver-vaga {
        border:
            1px solid #dbeafe;

        background:
            #eff6ff;

        color:
            #2563eb;
    }

    .btn-candidatar {
        border:
            1px solid #bbf7d0;

        background:
            #f0fdf4;

        color:
            #15803d;
    }


    /* =====================================================
       NENHUMA VAGA
       ===================================================== */

    .sem-resultados {
        margin-top: 30px;

        padding: 35px 25px;

        border:
            1px solid rgba(255, 255, 255, 0.09);

        border-radius: 18px;

        background:
            rgba(255, 255, 255, 0.06);

        text-align: center;

        color:
            rgba(255, 255, 255, 0.70);
    }

    .sem-resultados-icon {
        margin-bottom: 12px;

        font-size: 32px;
    }

    .sem-resultados h3 {
        margin: 0 0 7px;

        color: white;

        font-size: 18px;
    }

    .sem-resultados p {
        margin: 0;

        font-size: 13px;
    }


    /* =====================================================
       RESPONSIVO
       ===================================================== */

    @@media (max-width: 900px) {

        .automacao-page {
            padding:
                35px 22px 50px;
        }

        .vaga-card {
            padding: 20px;
        }

    }


    @@media (max-width: 600px) {

        .automacao-page {
            padding:
                28px 16px 40px;
        }

        .automacao-header h1 {
            font-size: 28px;
        }

        .filtros-card {
            padding: 20px;
        }

        .resultados-header {
            align-items: flex-start;
            flex-direction: column;

            gap: 10px;
        }

        .vaga-actions {
            flex-direction: column;
        }

        .vaga-button {
            width: 100%;
        }

    }

</style>


<div class="automacao-page">

    <div class="automacao-container">


        @* =====================================================
           MENSAGEM DA CANDIDATURA
           ===================================================== *@

        @if (TempData["MensagemCandidatura"] != null)
        {
            <div class="alert alert-@TempData["TipoMensagem"] alert-dismissible fade show mensagem-candidatura"
                 role="alert">

                @TempData["MensagemCandidatura"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fechar">
                </button>

            </div>
        }


        @* =====================================================
           CABEÇALHO
           ===================================================== *@

        <div class="automacao-header">

            <h1>
                Automação de vagas
            </h1>

            <p>
                Pesquise oportunidades no LinkedIn
                e execute ações de candidatura pelo JobApply.
            </p>

        </div>


        @* =====================================================
           FILTROS
           ===================================================== *@

        <div class="filtros-card">

            <div class="filtros-title">

                <div class="filtros-title-icon">
                    🔎
                </div>

                <span>
                    Pesquisa de vagas
                </span>

            </div>


            <form asp-action="Index"
                  method="get">

                <div class="row g-3">


                    @* SITE *@

                    <div class="col-md-2">

                        <label class="filtro-label">
                            Site
                        </label>

                        <select class="filtro-select">

                            <option>
                                LinkedIn
                            </option>

                        </select>

                    </div>


                    @* BUSCA *@

                    <div class="col-md-4">

                        <label class="filtro-label">
                            Buscar por
                        </label>

                        <input type="text"
                               name="busca"
                               value="@ViewBag.Busca"
                               class="filtro-input"
                               placeholder="Ex: Estágio TI" />

                    </div>


                    @* LOCALIZAÇÃO *@

                    <div class="col-md-3">

                        <label class="filtro-label">
                            Localização
                        </label>

                        <input type="text"
                               name="localizacao"
                               value="@ViewBag.Localizacao"
                               class="filtro-input"
                               placeholder="Ex: São Paulo" />

                    </div>


                    @* PERÍODO *@

                    <div class="col-md-3">

                        <label class="filtro-label">
                            Publicação
                        </label>

                        <select name="periodo"
                                class="filtro-select">

                            <option value="24h"
                                    selected="@(ViewBag.Periodo == "24h")">

                                Últimas 24 horas

                            </option>

                            <option value="semana"
                                    selected="@(ViewBag.Periodo == "semana")">

                                Última semana

                            </option>

                            <option value="mes"
                                    selected="@(ViewBag.Periodo == "mes")">

                                Último mês

                            </option>

                        </select>

                    </div>

                </div>


                <div class="buscar-area">

                    <button type="submit"
                            class="btn-buscar">

                        🔎

                        <span>
                            Buscar vagas
                        </span>

                    </button>

                </div>

            </form>

        </div>


        @* =====================================================
           RESULTADOS
           ===================================================== *@

        @if (Model.Any())
        {

            <div class="resultados-header">

                <h2>
                    Vagas encontradas
                </h2>

                <span class="resultado-contador">

                    @Model.Count
                    @(Model.Count == 1 ? "vaga" : "vagas")

                </span>

            </div>


            <div class="row g-4">

                @foreach (var vaga in Model)
                {

                    <div class="col-xl-4 col-md-6">

                        <div class="vaga-card">

                            <div class="vaga-card-top">


                                <div class="vaga-icon">
                                    💼
                                </div>


                                <h3 class="vaga-title">

                                    @vaga.Titulo

                                </h3>


                                <p class="vaga-info">

                                    <strong>
                                        Empresa:
                                    </strong>

                                    @vaga.Empresa

                                </p>


                                <p class="vaga-info">

                                    <strong>
                                        Localização:
                                    </strong>

                                    @vaga.Localizacao

                                </p>


                                @if (!string.IsNullOrWhiteSpace(vaga.Publicacao))
                                {

                                    <div class="vaga-publicacao">

                                        🕒
                                        &nbsp;
                                        @vaga.Publicacao

                                    </div>

                                }


                                @if (!string.IsNullOrWhiteSpace(vaga.StatusLinkedIn))
                                {

                                    <div class="vaga-status">

                                        ●
                                        &nbsp;
                                        @vaga.StatusLinkedIn

                                    </div>

                                }

                            </div>


                            @* BOTÕES *@

                            <div class="vaga-actions">

                                <a href="@vaga.Link"
                                   target="_blank"
                                   class="vaga-button btn-ver-vaga">

                                    Ver vaga

                                </a>


                                <a href="@Url.Action(
                                    "Candidatar",
                                    "Automacao",
                                    new
                                    {
                                        link = vaga.Link,
                                        busca = ViewBag.Busca,
                                        localizacao = ViewBag.Localizacao,
                                        periodo = ViewBag.Periodo
                                    })"
                                   class="vaga-button btn-candidatar">

                                    Candidatar-se

                                </a>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else if (!string.IsNullOrWhiteSpace(ViewBag.Busca))
        {

            <div class="sem-resultados">

                <div class="sem-resultados-icon">
                    🔎
                </div>

                <h3>
                    Nenhuma vaga encontrada
                </h3>

                <p>
                    Tente alterar os termos da pesquisa,
                    localização ou período.
                </p>

            </div>

        }

    </div>

</div>
